{
  "name": "structure-self-blocks",
  "displayName": "Structure Self Blocks",
  "description": "Warns when a db/structure-self.sql has schema_migrations rows outside the 50-row INSERT blocks that bin/rails db:migrate (Edgestitch) generates, and offers a quick fix that rebuilds them.",
  "version": "0.0.1",
  "publisher": "ClancyTools",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Linters"
  ],
  "keywords": [
    "nitro",
    "rails",
    "edgestitch",
    "structure-self",
    "migrations"
  ],
  "activationEvents": [
    "workspaceContains:**/db/structure-self.sql"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "structureSelfBlocks.recheckAll",
        "title": "Structure Self Blocks: Recheck All Files"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run bundle",
    "bundle": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs",
    "compile": "tsc -p ./",
    "watch": "esbuild src/extension.ts --bundle --outfile=out/extension.js --external:vscode --platform=node --format=cjs --sourcemap --watch",
    "pretest": "npm run compile",
    "test": "jest --config jest.config.js"
  },
  "devDependencies": {
    "@types/jest": "^29.5.12",
    "@types/node": "^18.x",
    "@types/vscode": "^1.85.0",
    "esbuild": "^0.25.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "typescript": "^5.4.0"
  },
  "license": "MIT"
}
